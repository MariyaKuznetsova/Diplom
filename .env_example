# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Settings
# Для локального запуска используйте HOST=localhost
# Для Docker HOST будет переопределен в docker-compose.yml на "db"
NAME=diplom
USER=postgres
